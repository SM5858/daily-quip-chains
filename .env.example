# Copy to .env.local and fill in. These are the SAME Supabase project the
# public app and the admin console use — this tool is a third front end on one
# database, not a fourth database.
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only, no NEXT_PUBLIC_ prefix: every model call happens inside a
# Server Action, so the key never reaches the browser.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key
